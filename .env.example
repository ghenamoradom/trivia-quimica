# Copy this file to .env.local for local development, or set these as
# Environment Variables in your Vercel project for production.

# Leave DATABASE_URL empty (or unset) to use a local SQLite file for testing.
# For production, set it to your Supabase Postgres connection string.
# Use the "Transaction pooler" connection string (port 6543), not the direct
# connection — the direct host is IPv6-only and many serverless platforms
# (including Vercel) only have IPv4 egress. Example shape:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Any long random string. Used to sign session cookies (JWT).
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string

# Admin login (same login form as students). Set your own username/password —
# do not reuse the placeholder values below.
ADMIN_USERNAME=change-this-admin-username
ADMIN_PASSWORD=change-this-admin-password
